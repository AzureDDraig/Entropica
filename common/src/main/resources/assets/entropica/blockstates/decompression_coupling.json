{
  "multipart": [
    { "apply": { "model": "entropica:block/decompression_coupling_core" } },
    { "when": { "axis": "y" }, "apply": { "model": "entropica:block/decompression_coupling_arm" } },
    { "when": { "axis": "y" }, "apply": { "model": "entropica:block/decompression_coupling_arm", "x": 180 } },
    { "when": { "axis": "z" }, "apply": { "model": "entropica:block/decompression_coupling_arm", "x": 270 } },
    { "when": { "axis": "z" }, "apply": { "model": "entropica:block/decompression_coupling_arm", "x": 90 } },
    { "when": { "axis": "x" }, "apply": { "model": "entropica:block/decompression_coupling_arm", "x": 90, "y": 90 } },
    { "when": { "axis": "x" }, "apply": { "model": "entropica:block/decompression_coupling_arm", "x": 90, "y": 270 } }
  ]
}